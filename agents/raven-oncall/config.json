{
  "providers": {
    "custom": {
      "apiBase": "https://openrouter.ai/api/v1",
      "models": [
        "anthropic/claude-opus-5"
      ]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "workspace",
      "model": "anthropic/claude-opus-5",
      "provider": "custom",
      "reasoningEffort": "high",
      "temperature": 1.0,
      "maxTokens": 32768,
      "contextWindowTokens": 400000,
      "maxToolIterations": 150,
      "llmCallTimeout": 1800,
      "taskBoard": {
        "enabled": false
      }
    }
  },
  "tools": {
    "restrictToWorkspace": false,
    "sandbox": {
      "backend": "none"
    },
    "exec": {
      "timeout": 600,
      "maxTimeout": 1200
    },
    "connectionAdd": true,
    "web": {
      "search": {
        "maxResults": 5
      }
    },
    "disabledTools": [
      "spawn",
      "cron",
      "read_skill",
      "use_skill",
      "hub",
      "deep_research",
      "image_generate",
      "text_to_speech",
      "video_generate",
      "create_playbook",
      "deliver_files",
      "find_skill",
      "load_playbook",
      "plugin",
      "raven_config",
      "run_subagent_dag",
      "browser_click",
      "browser_navigate",
      "browser_press",
      "browser_screenshot",
      "browser_scroll",
      "browser_snapshot",
      "browser_tabs",
      "browser_type"
    ],
    "mcpServers": {
      "trail": {
        "args": [
          "C:/Users/kumarnaresh/AppData/Local/hermes/integrations/trail-code/trail.mjs",
          "mcp"
        ],
        "enabled": true,
        "command": "C:/Users/kumarnaresh/AppData/Local/hermes/tools/node-26.12.1-win32-x64/node.exe"
      }
    }
  },
  "memory": {
    "backend": "everos",
    "userId": "naresh",
    "agentId": "raven-oncall",
    "memoryTopK": 5
  },
  "plugins": {
    "config": {
      "everos-memory": {
        "base_url": "http://127.0.0.1:8000",
        "root": "C:/learn/everos-local/data",
        "port": 8000,
        "owned": false
      },
      "oncall-flow": {
        "enabled": true
      },
      "obsidian-wiki": {
        "enabled": true
      }
    },
    "disabled": []
  },
  "skillForge": {
    "alwaysMax": 20,
    "localDirs": [
      {
        "name": "obsidian-wiki-ops",
        "alwaysEnabled": true,
        "path": "C:/learn/obsidian-wiki/.skills"
      },
      {
        "name": "obsidian-wiki-core",
        "alwaysEnabled": true,
        "path": "C:/Users/kumarnaresh/.agents/skills-obsidian-wiki"
      }
    ]
  }
}