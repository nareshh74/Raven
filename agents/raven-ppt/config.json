{
  "language": "en",
  "agents": {
    "defaults": {
      "model": "z-ai/glm-5.3-flash",
      "provider": "ppt",
      "contextWindowTokens": 1000000,
      "llmCallTimeout": 1800,
      "maxToolIterations": 600,
      "maxConcurrentSubagents": 2,
      "reasoningEffort": "high",
      "temperature": 0.95,
      "modelOverrides": {
        "grok": {
          "extra_body": {
            "provider": {
              "only": [
                "xAI"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "glm-5.3-flash": {
          "extra_body": {
            "provider": {
              "order": [
                "Z.AI",
                "DeepInfra",
                "Novita"
              ],
              "allow_fallbacks": false
            }
          }
        }
      },
      "llmErrorRetryDelays": [
        30,
        60,
        120,
        240,
        300,
        300,
        300,
        300
      ],
      "llmRetryAfterOutput": true,
      "compaction": {
        "enabled": true,
        "triggerRatio": 0.85
      },
      "taskBoard": {
        "enabled": false
      }
    }
  },
  "providers": {
    "ppt": {
      "apiBase": "https://openrouter.ai/api/v1",
      "models": [
        "z-ai/glm-5.3-flash"
      ]
    }
  },
  "tools": {
    "restrictToWorkspace": false,
    "exec": {
      "denyPatterns": [
        "\\bdel\\s+/[fq]\\b",
        "\\brmdir\\s+/s\\b",
        "(?:^|[;&|]\\s*)format\\b",
        "\\b(mkfs|diskpart)\\b",
        "\\bdd\\s+if=",
        ">\\s*/dev/sd",
        ":\\(\\)\\s*\\{.*\\};\\s*:"
      ]
    },
    "sandbox": {
      "backend": "none"
    },
    "web": {
      "search": {
        "maxResults": 10
      }
    },
    "disabledTools": [
      "create_playbook",
      "cron",
      "deep_research",
      "deliver_files",
      "find_skill",
      "hub",
      "image_generate",
      "image_search",
      "load_playbook",
      "plugin",
      "raven_config",
      "read_skill",
      "run_subagent_dag",
      "spawn",
      "text_to_speech",
      "video_generate",
      "browser_click",
      "browser_navigate",
      "browser_press",
      "browser_screenshot",
      "browser_scroll",
      "browser_snapshot",
      "browser_tabs",
      "browser_type"
    ],
    "mcpServers": {
      "trail": {
        "args": [
          "C:/Users/kumarnaresh/AppData/Local/hermes/integrations/trail-code/trail.mjs",
          "mcp"
        ],
        "enabled": true,
        "command": "C:/Users/kumarnaresh/AppData/Local/hermes/tools/node-26.7.0-win32-x64/node.exe"
      }
    }
  },
  "context": {
    "curator_model": ""
  },
  "memory": {
    "backend": "hindsight",
    "userId": "raven-design",
    "agentId": "raven-design",
    "memoryTopK": 5
  },
  "plugins": {
    "config": {
      "ppt-engine": {
        "enabled": true,
        "profile": "script_author",
        "composerModel": "",
        "readerEffort": "low",
        "renderDpi": 144
      },
      "obsidian-wiki": {
        "enabled": true
      }
    }
  },
  "skillForge": {
    "alwaysMax": 9,
    "localDirs": [
      {
        "name": "obsidian-wiki-ops",
        "alwaysEnabled": true,
        "path": "C:/learn/obsidian-wiki/.skills"
      },
      {
        "name": "obsidian-wiki-core",
        "alwaysEnabled": true,
        "path": "C:/Users/kumarnaresh/.agents/skills-obsidian-wiki"
      }
    ]
  }
}
