{
  "providers": {
    "openrouter": {
      "apiBase": "https://openrouter.ai/api/v1"
    }
  },
  "agents": {
    "defaults": {
      "model": "openai/gpt-5.6-sol-pro",
      "provider": "openrouter",
      "reasoningEffort": "medium",
      "maxToolIterations": 40,
      "maxTokens": 16384,
      "requestTimeoutSeconds": 600,
      "taskBoard": {
        "enabled": false
      }
    }
  },
  "memory": {
    "backend": "everos",
    "userId": "naresh",
    "agentId": "raven-research",
    "memoryTopK": 5
  },
  "plugins": {
    "config": {
      "everos-memory": {
        "base_url": "http://127.0.0.1:8000",
        "root": "C:/learn/everos-local/data",
        "port": 8000,
        "owned": false
      },
      "research-flow": {
        "enabled": true,
        "thinkClosingTagRequired": false,
        "measuredGuidance": false,
        "maxIterations": 20,
        "wallClockSeconds": 3600,
        "deadEndRetry": {
          "enabled": true,
          "maxRetries": 1,
          "reasons": []
        },
        "budgetNote": {
          "enabled": true,
          "warnRatio": 0.3
        },
        "forceFinalize": {
          "enabled": true
        },
        "spinBreaker": {
          "enabled": true
        },
        "fetchFloor": {
          "enabled": true
        },
        "fetchGate": {
          "enabled": true,
          "k": 15
        },
        "sufficiency": {
          "enabled": true,
          "minSearches": 1,
          "minFetches": 2,
          "judgeListing": true,
          "timeoutSeconds": 60,
          "attemptTimeoutSeconds": 30,
          "maxTokens": 4096
        },
        "verify": {
          "constraintRubric": true,
          "strictRejectOnly": true,
          "reasoningEffort": "low",
          "timeoutSeconds": 300,
          "attemptTimeoutSeconds": 300,
          "maxTokens": 16384
        },
        "digest": {
          "verbatimHeadChars": 800
        },
        "search": {
          "includeSnippets": true,
          "snippetDedupByDocid": true,
          "saturation": {
            "enabled": true,
            "k": 5,
            "onSaturate": "widen"
          }
        },
        "finalShape": {
          "record": true,
          "requireMarker": false,
          "reportStructure": true,
          "reportFormatOverride": true,
          "reportDepth": true,
          "reportLayout": "reader",
          "reportReminder": true,
          "reportBounce": true,
          "processAppendix": true
        },
        "askUser": {
          "enabled": true,
          "mode": "when_needed",
          "delivery": "tool"
        },
        "conversation": {
          "enabled": true,
          "gate": "agentic",
          "gateMaxTokens": 4096,
          "gateTimeoutSeconds": 90,
          "researchMemo": true,
          "identityScope": "turn"
        },
        "plainFirst": {
          "enabled": true,
          "judge": true
        },
        "version": "dr@3.7-filetools-askuser-derive-numeric-cite-rank-tiers-plain-high-reader"
      },
      "obsidian-wiki": {
        "enabled": true
      }
    },
    "disabled": []
  },
  "tools": {
    "web": {
      "search": {
        "maxResults": 5
      }
    },
    "disabledTools": [
      "exec",
      "spawn",
      "message",
      "cron",
      "read_skill",
      "use_skill",
      "find_skill",
      "image_generate",
      "text_to_speech",
      "video_generate",
      "understand_media",
      "deep_research",
      "deliver_files",
      "plugin",
      "raven_config",
      "create_playbook",
      "load_playbook",
      "run_subagent_dag",
      "browser_click",
      "browser_navigate",
      "browser_press",
      "browser_screenshot",
      "browser_scroll",
      "browser_snapshot",
      "browser_tabs",
      "browser_type"
    ],
    "mcpServers": {
      "trail": {
        "args": [
          "C:/Users/kumarnaresh/AppData/Local/hermes/integrations/trail-code/trail.mjs",
          "mcp"
        ],
        "enabled": true,
        "command": "C:/Users/kumarnaresh/AppData/Local/hermes/tools/node-26.12.1-win32-x64/node.exe"
      }
    }
  },
  "context": {
    "dropSegments": [
      "identity",
      "active_skills",
      "skills"
    ]
  },
  "skillForge": {
    "alwaysMax": 20,
    "localDirs": [
      {
        "name": "obsidian-wiki-ops",
        "alwaysEnabled": true,
        "path": "C:/learn/obsidian-wiki/.skills"
      },
      {
        "name": "obsidian-wiki-core",
        "alwaysEnabled": true,
        "path": "C:/Users/kumarnaresh/.agents/skills-obsidian-wiki"
      }
    ]
  }
}